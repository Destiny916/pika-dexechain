# pika-w1 deployment targets. Override any value through the environment.

PC1_HOST="${PC1_HOST:-dexforce@192.168.20.20}"
PC1_INSTALL_ROOT="${PC1_INSTALL_ROOT:-/home/dexforce/workspace/pika_w1}"
PC1_DEB="${PC1_DEB:-${PIKA_MIGRATE_ROOT}/dexe-sensors_0.4.3+20260630105651+a5b1db7_arm64.deb}"

PC2_HOST="${PC2_HOST:-dexforce@192.168.20.21}"
PC2_INSTALL_ROOT="${PC2_INSTALL_ROOT:-/home/dexforce/workspace/pika_w1}"
PC2_PAYLOAD_DIR="${PC2_PAYLOAD_DIR:-${PIKA_MIGRATE_ROOT}/tools/pika_w1/payloads/pc2}"

# Runtime defaults for the standalone camera controls.
PC1_ROS_DOMAIN_ID="${PC1_ROS_DOMAIN_ID:-20}"
PC1_KFC_IP="${PC1_KFC_IP:-192.168.20.30}"
PC1_KFC_TOPIC="${PC1_KFC_TOPIC:-/camera/kfc_compressed_external}"
PC2_ROS_DOMAIN_ID="${PC2_ROS_DOMAIN_ID:-20}"
